# Copiez ce fichier en ".env" puis remplacez la valeur par votre clé (console.anthropic.com).
ANTHROPIC_API_KEY=sk-ant-votre-cle-ici

# Facultatif
MODEL=claude-sonnet-5-5
PORT=3000
MAX_TOKENS=8000

# Fichier de la base des comptes (par défaut : storage/retroviz.db)
# DB_PATH=storage/retroviz.db

# Comptes administrateurs (page « Relecture »), séparés par des virgules
# ADMIN_EMAILS=vous@exemple.fr

# Dossier des factures envoyées (par défaut : storage/uploads)
# UPLOAD_DIR=storage/uploads

# Observateur (npm run observer) : budget mensuel en euros, obligatoire pour la recherche web et l'extraction.
# L'Observateur s'arrête dès qu'il est atteint. Sans budget ni clé API : données officielles seulement (gratuit).
# OBSERVER_BUDGET_EUR=10
# OBSERVER_MODEL=claude-sonnet-5-5
# OBSERVER_EUR_PAR_USD=0.92
